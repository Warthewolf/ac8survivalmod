# AC8 Survival Mode: your machine's settings for the build tools.
#
#   python -I tools/env.py --init     copies this file to .env (git-ignored: your paths and key never reach git)
#   python -I tools/env.py --check    shows every setting, where it came from, whether its path exists
#
# NAME=value, one a line; spaces in a value are fine, no quotes needed; forward slashes work everywhere.
# A variable already set in your environment wins over .env, and an empty value counts as not set.
# One .env in the main git tree serves every worktree made from it.
# See CONTRIBUTING.md for the whole setup.

# ---- The game (needed for a full build) -------------------------------------------------------------------------
# ACE COMBAT 8's install folder: the one that holds Game/
AC8_DIR=C:/Program Files (x86)/Steam/steamapps/common/ACE COMBAT 8
# Its Paks folder, if not AC8_DIR/Game/Content/Paks
#AC8_PAKS=
# Its UE4SS Mods folder, where builds are installed, if not AC8_DIR/Game/Binaries/Win64/ue4ss/Mods
#AC8_MODS=

# The game's AES key (0x...), to read its paks. Set the key itself, OR the path of a JSON file holding it as
# "aesKey" (ACE8AircraftBuilder's settings.json does). Never commit it.
AC8_AES_KEY=
#AC8_AES_SETTINGS=C:/ACE8AircraftBuilder/settings.json

# ---- The toolchain ---------------------------------------------------------------------------------------------
# LLVM's bin folder (clang, lld-link, llvm-dlltool) for the native runtime, if it isn't in tools/llvm/LLVM/bin or on PATH
#LLVM_BIN=C:/Program Files/LLVM/bin
# Python 3.8+ is expected on PATH as `python`, and Git Bash (sh) for the .sh tools.

# ---- Releases ---------------------------------------------------------------------------------------------------
# Where release zips and their .buildhash.txt go, if not the main git tree's build/release
#RELEASE_DIR=

# ---- Optional: VALKA's X-02S assets (tools/x02s/build.sh) ----------------------------------------------------------
#UE=C:/Program Files/Epic Games/UE_5.4
#UMODEL=C:/Tools/umodel_ace_combat_7_PC.exe
#AC7=C:/Ace Combat 7 Exports
# The AC8 template project (the folder of Live.uproject, AC8's own classes compiled): AC7's LaserInterceptor,
# tools/laser7/build.sh (ZFA=1 dev builds)
#AC8_LIVE_PROJECT=C:/AC8LiveProject

# ---- Optional: THE TANICORN (tools/tanicorn/build.sh; also needs UE and AC8_LIVE_PROJECT above) -------------------
# Blender 3.3's blender.exe (prepares the turret meshes)
#BLENDER=C:/Program Files/Blender Foundation/Blender 3.3/blender.exe

# ---- Optional: AC7 sound effects (tools/ac7_sfx.py) ----------------------------------------------------------------
#AC7_BNK_DIR=C:/Ace Combat PAKS/bnk's/Windows
#AC7_SE_BNK=C:/Ace Combat PAKS/Music Banks and Sound Effects AC7/Windows/game_se.bnk
#VGMSTREAM=C:/Tools/vgmstream-cli.exe

# ---- Optional: reverse engineering (tools/re/exe.py) ---------------------------------------------------------------
# Where exe.py caches AceCombat8.exe's parsed tables, if not build/re/exe_cache.pkl
#EXE_CACHE=

# ---- Optional: the leaderboard (leaderboard/README.md; only the maintainer has its keys) ---------------------------
# The git-ignored files with its address and keys, if not the main tree's leaderboard/submit.local and keys.secret
#SV_LB_LOCAL=
#SV_LB_SECRETS=
# 0: packaging doesn't register builds on the leaderboard
#SV_LB_REGISTER=1
