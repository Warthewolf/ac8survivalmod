+                killCopy(id or 0, o, true); n = n + 1
+                if id then M.copies[id] = nil end
+            end
+            M.cunits[unit] = nil
+        end
+    end
+    log(string.format("coop: soft resync done: %d flights the host no longer has taken down here (%d copies)", units, n))
+end
