+local SOFT_RS_S = 8
+local function softResyncTick(now)
+    local r = M.softRs
+    if not r or now - r.at < SOFT_RS_S or #M.spawnQ > 0 then return end
+    M.softRs = nil
+    local n, units = 0, 0
